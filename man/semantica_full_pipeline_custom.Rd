\item{plot_network_max_items}{Maximum number of BEFORE-pool items rendered
in the semantic network plot. Selected items are always retained.}

\item{plot_mds_max_items}{Maximum number of pool items included in the
interactive MDS plot. Selected items are always retained.}

\item{plot_path_proxy_max_items}{Maximum number of pool items represented in
the fast BEFORE path-diagram proxy. Selected items are always retained.}

\item{include_interactive_plot}{Logical; construct Plot 9's interactive MDS
widget. Disable this when only static diagnostics are needed.}

\item{plot_progress}{Logical; print per-plot elapsed-time progress.}

\item{verbose}{Print progress messages.}

\item{embedding_task}{Embedding-task policy; \code{"auto"} applies documented model-specific instructions where required.}

\item{embedding_instruction}{Optional explicit embedding prefix/instruction.}

\item{content_alignment_mode}{Content-definition alignment behavior:
\code{"diagnostic"} (default), \code{"guard"}, or \code{"off"}. Guard mode is
feasibility-aware and removes only clear factor mismatches or explicit
exclusion conflicts; ordinary ambiguity remains diagnostic.}

\item{polarity_action}{Selection behavior for wording polarity flags:
\code{"diagnostic"} (default), \code{"guard"}, or \code{"off"}.}

\item{within_target_method}{Automatic cohesion-target estimator when
\code{within_similarity_target = NULL}: \code{"nonredundant_median"} (default) uses
nonredundant within-factor similarities from the current pool/model;
\code{"legacy_q40"} reproduces the older 0.25--0.55-clamped rule.}

\item{validation_n_on_inadmissible}{When validation-N planning is requested
and the selected semantic-proxy ESEM is inadmissible, \code{"skip"} (default)
avoids a misleading sample-size calculation; \code{"run"} forces the legacy
PFA-informed sensitivity exercise.}

\item{...}{Additional arguments passed to \code{semantica_pipeline()}.}

\item{backend_spec, embed_backend_spec}{Optional explicit custom backend
contracts created by \code{\link[=semantica_backend_spec]{semantica_backend_spec()}} for generation and
embeddings respectively.}

\item{embed_base_url}{Optional provider/server URL for a separate embedding
backend.

Executes the complete psychometric scale construction workflow in a single
function call: LLM item generation, semantic embedding, ACO-ESEM optimization
with DFI calibration, and comprehensive diagnostic plotting.}

\item{esem_cadence_mode}{\code{"adaptive"} preserves entropy-responsive checkpoint
scheduling; \code{"fixed"} evaluates ESEM exactly every \code{esem_every} iterations.}

\item{generation_seed}{Optional generation-specific seed. \code{NULL} inherits
the ACO/master \code{seed}. Supported generation backends receive deterministic
per-call seeds; unsupported protocols are recorded as uncontrolled. Backend
seed control does not guarantee byte-identical text, so exact downstream
replay requires reusing the realized fingerprinted item pool.}

\item{htmt_objective_role}{Whether HTMT-like semantic overlap is diagnostic
only (default) or enters the scalar proxy objective as a legacy penalty.}

\item{elite_multicriteria_rerank}{Logical; apply the scalar final ESEM
diagnostic rerank/quality bonus to the elite archive. This is a
multicriteria decision-utility rerank, not Pareto dominance or a
multiobjective ACO archive. \code{NULL} resolves to \code{TRUE} unless the deprecated
compatibility alias is supplied.}
}
\value{
A named list containing:
\itemize{
\item \code{generation}: Output from \code{semantica_pipeline()}.
\item \code{optimization}: Output from \code{ACO_with_ESEM()}.
\item \code{plots}: List of \code{ggplot}/\code{plotly} objects (or \code{NULL}).
\item \code{best_items}: Character vector of selected item IDs.
\item \code{factor_assignment}: Named vector mapping items to factors.
\item \code{best_objective}: Final optimization utility; interpret it together with
\code{objective_context}, not as a universal scale-quality score.
\item \code{objective_context}: Evidence regime and comparability metadata for the
optimization utility.
\item \code{selection_semantic_context}: Candidate-pool versus selected semantic
discrimination/gap context; selected values are post-selection descriptive.
\item \code{factor_semantic_diagnostics}: Factor-specific selected semantic separation.
\item \code{esem_state}: Consolidated technical and structural-quality ESEM state.
\item \code{pfa_esem_discrepancy}: Complementary PFA/ESEM discrepancy state.
\item \code{item_structure_diagnostics}: Item-level ESEM loading and cross-loading diagnostics.
\item \code{embedding_diagnostics}: Embedding dimensionality, norm, and model checks.
\item \code{cosine_diagnostics}: Cosine similarity distribution diagnostics.
\item \code{fit_indices}: List of CFI, RMSEA, SRMR, AVE, HTMT.
\item \code{semantic_score}: Sigmoid semantic score of the final solution.
\item \code{proposal_objective_score}: Semantic/PFA proposal objective for the final
item set, prior to ESEM-guided scoring.
The legacy \code{search_objective_score} field is retained as an alias.
\item \code{final_guided_objective_score}: Final objective after requested ESEM
guidance and archive reranking.
\item \code{search_guidance_status}: Whether selection was ESEM-guided, explicitly
semantic-only, or continued under an explicit semantic fallback.
\item \code{candidate_counts}: Generated, eligible, and selected-target counts by
factor after content-pool screening.
\item \code{pfa_diagnostics}: Sample-free pseudo-factor-analysis diagnostics.
\item \code{pfa_unit_diagnostics}: Optional facet/unit-level PFA diagnostics from
averaged unit embeddings.
\item \code{reference_sample_size}: RMSEA-power reference fit N for semantic ESEM/DFI.
\item \code{semantic_n_sensitivity}: Final selected semantic-proxy ESEM refits over
nearby reference-N anchors.
\item \code{cosine_adjustment_sensitivity}: None-versus-mean-centered embedding
cosine sensitivity diagnostic.
\item \code{recommended_validation_n}: PFA-informed Monte Carlo response-data
sample-size planning diagnostic.
\item \code{semantic_similarity_reduction}: Metrics tracking within-factor redundancy change.
\item \code{optimization$esem_alignment} and
\code{optimization$esem_admissibility}: Final factor-axis mapping and
canonical fit-admissibility diagnostics in the nested optimizer result.
\item \code{semantic_resampling_stability}: Stratified within/between-pair bootstrap
and item-jackknife sensitivity diagnostics. Pair similarities are dependent,
so intervals are descriptive representation-sensitivity summaries rather
than respondent-sampling confidence intervals.
\item \code{semantic_pair_perturbation_stability} and \code{split_half_stability}: legacy
compatibility aliases; new analyses no longer use their uncalibrated 0.10
stable/unstable rule.
\item \code{resource_plan}, \code{performance}, and \code{evaluation_telemetry}: Resolved
workers/devices, stage timings, and cache-aware evaluation accounting.
\item \code{reproducibility}: Master/task seeds, RNG configuration, effective
resources, package versions, and optimizer settings.
\item \code{summary}: Compact summary object from ACO.
}
}
\description{
Retains the historical flattened argument surface for existing scripts and
method-development workflows. New configurable workflows can use
\code{\link[=semantica_full_pipeline]{semantica_full_pipeline()}} with configuration objects.
}
\section{Side effects}{

May perform provider network I/O, persistent embedding-cache I/O, local
Python/model initialization, stochastic ACO/DFI computation, parallel worker
creation, response-data fitting, and optional plot-file writes.
}

\section{Reproducibility}{

The returned \code{reproducibility} record retains master/task seeds, resource and
model metadata, and optimizer settings. Provider aliases should be treated as
mutable unless an explicit model revision is available and recorded.
}

\examples{
\dontrun{
# Requires valid API credentials or an available local backend.
result <- semantica_full_pipeline_custom(
  backend = "openai",
  scale_name = "Cognitive Agility",
  scale_description = "Clear and adaptive thinking.",
  factors = list(
    Clarity = list(description = "Clear thinking.", n_items = 8L),
    Flexibility = list(description = "Adaptive thinking.", n_items = 8L)
  ),
  i.per.f = c(Clarity = 3L, Flexibility = 3L),
  ants = 20L,
  max.iter = 10L,
  generate_plots = TRUE,
  verbose = FALSE
)
}
}
